{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string", "not": { "const": "latest" } }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "zone": {
      "type": "string",
      "description": "Zone to mirror, e.g. example.com",
      "pattern": "^$|^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}\\.?$"
    },
    "poweradmin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^$|^https://" },
        "timeoutSeconds": { "type": "number", "minimum": 1, "maximum": 60 },
        "verifyTls": { "type": "boolean" }
      }
    },
    "route53": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostedZoneId": { "type": "string", "pattern": "^$|^Z[A-Z0-9]{1,31}$" },
        "credentials": { "enum": ["secret", "ambient"] },
        "updatePcentThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.3 },
        "deletePcentThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.2 }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dryRun": { "type": "boolean" },
        "pollInterval": { "type": "number", "minimum": 1 },
        "fullSyncInterval": { "type": "number", "minimum": 30 },
        "retryInterval": { "type": "number", "minimum": 1 },
        "livenessMaxAge": { "type": "number", "minimum": 60 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraRejectTypes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9]+$" } },
        "extraRejectNetworks": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } },
        "rejectNames": { "type": "array", "items": { "type": "string" } },
        "ignoreRoute53Aliases": { "type": "boolean" },
        "ignoreAcmValidation": { "type": "boolean" }
      }
    },
    "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "secretEnv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "existingSecretKeys": {
          "type": "object",
          "propertyNames": { "enum": ["POWERADMIN_API_KEY", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"] },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "values": {
          "type": "object",
          "propertyNames": { "enum": ["POWERADMIN_API_KEY", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"] },
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "automountServiceAccountToken": { "type": "boolean" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "scrapeAnnotations": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "type": "object" },
        "severity": { "type": "string" },
        "staleAfterSeconds": { "type": "integer", "minimum": 60 },
        "metricSelector": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingress": { "type": "object" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowDns": { "type": "boolean" },
            "allowHttpsToInternet": { "type": "boolean" },
            "rules": { "type": "array" }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "extraEnv": { "type": "array" }
  }
}
